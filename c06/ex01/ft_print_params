// Function to calculate string length using while loop
int str_len(char *s) {
    int len = 0;
    while (s[len]) {
        len++;
    }
    return len;
}

int main(int argc, char *argv[]) {
    int i = argc - 1;

    while (i > 0) {
        int len = str_len(argv[i]);
        write(1, argv[i], len);
        write(1, "\n", 1);
        i--;
    }

    return 0;
}
