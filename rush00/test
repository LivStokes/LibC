Here’s a better version that keeps the same behavior but is safer and easier to understand:

#include <unistd.h>
#include <stddef.h>

static void	ft_putchar(char c)
{
	write(1, &c, 1);
}

/**
 * Prints one line of the rectangle.
 * @param width: number of columns
 * @param first: left character
 * @param mid: character used in the middle
 * @param last: right character
 */
static void	print_line(size_t width, char first, char mid, char last)
{
	if (width == 0)
		return ;

	ft_putchar(first);

	for (size_t j = 1; j + 1 < width; ++j)
		ft_putchar(mid);

	if (width > 1)
		ft_putchar(last);

	ft_putchar('\n');
}

/**
 * Prints a rectangle (rush style) of width x and height y.
 * Uses / and \ for corners, * for borders, and space inside.
 */
void	rush(size_t width, size_t height)
{
	if (width == 0 || height == 0)
		return ;

	const char TOP_LEFT = '/';
	const char TOP_RIGHT = '\\';
	const char BOTTOM_LEFT = '\\';
	const char BOTTOM_RIGHT = '/';
	const char HORIZONTAL = '*';
	const char VERTICAL = '*';
	const char FILL = ' ';

	for (size_t i = 0; i < height; ++i)
	{
		if (i == 0)
			print_line(width, TOP_LEFT, HORIZONTAL, TOP_RIGHT);
		else if (i == height - 1)
			print_line(width, BOTTOM_LEFT, HORIZONTAL, BOTTOM_RIGHT);
		else
			print_line(width, VERTICAL, FILL, VERTICAL);
	}
}



